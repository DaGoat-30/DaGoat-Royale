import * as THREE from 'three';

export class Loot {
  constructor(scene) {
    this.scene = scene;
    this.items = [];
  }

  spawnCluster(count = 18) {
    const options = [
      { type: 'medkit', color: '#4ae090', label: 'Med Kit' },
      { type: 'shield', color: '#7ee8ff', label: 'Shield' },
      { type: 'ammo', color: '#ffce5a', label: 'Ammo' },
      { type: 'potion', color: '#ff5e7a', label: 'Health Potion' },
      { type: 'weapon', color: '#ffb866', label: 'Weapon' },
    ];

    for (let i = 0; i < count; i += 1) {
      const option = options[i % options.length];
      const mesh = new THREE.Mesh(
        new THREE.BoxGeometry(1, 1, 1),
        new THREE.MeshStandardMaterial({ color: option.color, emissive: option.color, emissiveIntensity: 0.18 })
      );
      mesh.position.set((Math.random() - 0.5) * 80, 0.5, (Math.random() - 0.5) * 80);
      mesh.castShadow = true;
      this.scene.add(mesh);
      this.items.push({ type: option.type, label: option.label, mesh, amount: 1 });
    }
  }

  update(dt, player) {
    this.items.forEach((item) => {
      item.mesh.rotation.y += dt * 1.5;
      if (player && item.mesh.position.distanceTo(player.position) < 2.8) {
        this.collect(item, player);
      }
    });
  }

  collect(item, player) {
    if (item.type === 'medkit' || item.type === 'potion') {
      player.health = Math.min(100, player.health + 25);
    }
    if (item.type === 'shield') {
      player.shield = Math.min(100, player.shield + 35);
    }
    if (item.type === 'ammo') {
      player.reserveAmmo += 20;
    }
    if (item.type === 'weapon') {
      player.weaponIndex = (player.weaponIndex + 1) % player.weapons.length;
      player.setWeapon(player.weaponIndex);
    }

    item.mesh.visible = false;
    item.collected = true;
  }
}
