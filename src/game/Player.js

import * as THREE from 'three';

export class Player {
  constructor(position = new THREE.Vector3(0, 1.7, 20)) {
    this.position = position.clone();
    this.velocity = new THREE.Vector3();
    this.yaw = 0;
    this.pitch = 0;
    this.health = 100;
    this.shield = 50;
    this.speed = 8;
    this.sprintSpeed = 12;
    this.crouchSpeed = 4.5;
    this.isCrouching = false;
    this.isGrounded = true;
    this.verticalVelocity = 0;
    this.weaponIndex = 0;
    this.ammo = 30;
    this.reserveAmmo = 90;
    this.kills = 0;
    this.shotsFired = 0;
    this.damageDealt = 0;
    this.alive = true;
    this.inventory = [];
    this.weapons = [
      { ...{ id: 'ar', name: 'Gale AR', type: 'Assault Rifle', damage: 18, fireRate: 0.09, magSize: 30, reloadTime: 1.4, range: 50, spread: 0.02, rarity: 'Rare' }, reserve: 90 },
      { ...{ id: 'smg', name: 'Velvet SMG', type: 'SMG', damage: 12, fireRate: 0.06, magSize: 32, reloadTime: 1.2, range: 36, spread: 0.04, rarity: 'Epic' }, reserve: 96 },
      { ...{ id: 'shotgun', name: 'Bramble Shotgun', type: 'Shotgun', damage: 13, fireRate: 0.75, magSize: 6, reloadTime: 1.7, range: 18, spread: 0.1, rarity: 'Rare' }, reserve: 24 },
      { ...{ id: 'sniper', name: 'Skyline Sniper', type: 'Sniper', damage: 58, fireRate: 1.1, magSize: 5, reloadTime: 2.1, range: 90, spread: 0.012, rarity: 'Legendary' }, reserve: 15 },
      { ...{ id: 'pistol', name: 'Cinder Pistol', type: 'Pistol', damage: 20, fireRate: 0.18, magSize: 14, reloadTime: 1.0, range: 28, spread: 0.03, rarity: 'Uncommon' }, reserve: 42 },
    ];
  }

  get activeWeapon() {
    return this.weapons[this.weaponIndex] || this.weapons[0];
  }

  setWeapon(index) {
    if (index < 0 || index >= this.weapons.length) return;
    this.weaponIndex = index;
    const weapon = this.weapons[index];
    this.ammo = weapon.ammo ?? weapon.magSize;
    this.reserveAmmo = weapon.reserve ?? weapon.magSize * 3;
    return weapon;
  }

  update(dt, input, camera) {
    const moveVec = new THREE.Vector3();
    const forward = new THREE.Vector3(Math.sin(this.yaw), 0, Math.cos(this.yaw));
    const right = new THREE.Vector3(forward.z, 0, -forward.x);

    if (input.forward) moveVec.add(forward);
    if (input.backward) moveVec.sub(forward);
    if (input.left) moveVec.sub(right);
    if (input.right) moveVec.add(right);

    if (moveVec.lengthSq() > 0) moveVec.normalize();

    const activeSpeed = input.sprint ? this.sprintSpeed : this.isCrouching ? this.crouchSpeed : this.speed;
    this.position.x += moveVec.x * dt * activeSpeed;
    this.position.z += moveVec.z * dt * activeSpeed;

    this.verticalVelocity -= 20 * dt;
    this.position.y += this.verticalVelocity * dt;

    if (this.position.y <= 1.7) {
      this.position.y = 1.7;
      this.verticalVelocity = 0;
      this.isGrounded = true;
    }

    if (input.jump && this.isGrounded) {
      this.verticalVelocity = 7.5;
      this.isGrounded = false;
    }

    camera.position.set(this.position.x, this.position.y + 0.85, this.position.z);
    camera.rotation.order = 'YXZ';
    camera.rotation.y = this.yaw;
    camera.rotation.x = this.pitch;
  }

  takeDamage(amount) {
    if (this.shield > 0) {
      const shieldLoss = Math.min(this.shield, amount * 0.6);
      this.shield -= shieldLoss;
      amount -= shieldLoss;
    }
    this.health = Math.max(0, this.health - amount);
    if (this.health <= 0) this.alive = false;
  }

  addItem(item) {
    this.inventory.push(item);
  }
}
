export class WeaponSystem {
  constructor() {
    this.weapons = weaponCatalog.map((weapon) => ({ ...weapon, reserve: weapon.magSize * 3 }));
  }

  createWeaponSnapshot(index = 0) {
    return { ...weaponCatalog[index], reserve: weaponCatalog[index].magSize * 3 };
  }

  getWeaponById(id) {
    return weaponCatalog.find((weapon) => weapon.id === id) || weaponCatalog[0];
  }
}
