import * as THREE from 'three';

export class Bot {
  constructor(index, scene) {
    this.id = `bot-${index}`;
    this.difficulty = ['Easy', 'Normal', 'Hard', 'Insane'][index % 4];
    this.mesh = new THREE.Group();
    const bodyMaterial = new THREE.MeshStandardMaterial({
      color: index % 2 === 0 ? '#7ce2b6' : '#ff8a7a',
      roughness: 0.85,
    });

    const body = new THREE.Mesh(new THREE.CapsuleGeometry(0.7, 1.7, 8, 12), bodyMaterial);
    body.castShadow = true;
    body.position.y = 1.2;
    this.mesh.add(body);

    const head = new THREE.Mesh(
      new THREE.SphereGeometry(0.42, 12, 12),
      new THREE.MeshStandardMaterial({ color: '#d9ebff' })
    );
    head.position.y = 2.4;
    head.castShadow = true;
    this.mesh.add(head);

    this.position = new THREE.Vector3((Math.random() - 0.5) * 50, 0, (Math.random() - 0.5) * 50);
    this.mesh.position.copy(this.position);
    scene.add(this.mesh);

    this.health = 100;
    this.shield = 30;
    this.alive = true;
    this.state = 'roam';
    this.cooldown = 0;
    this.aimError = this.difficulty === 'Easy' ? 0.18 : this.difficulty === 'Normal' ? 0.09 : this.difficulty === 'Hard' ? 0.05 : 0.03;
    this.weapon = { damage: 12, range: 28, fireRate: 0.5 };
    this.angle = Math.random() * Math.PI * 2;
  }

  update(dt, player, stormRadius) {
    if (!this.alive) return;

    const toPlayer = player.position.clone().sub(this.position);
    const distance = toPlayer.length();

    if (distance < 24) {
      this.state = 'attack';
      const direction = toPlayer.normalize();
      this.mesh.rotation.y = Math.atan2(direction.x, direction.z);

      if (distance > 10) {
        this.position.x += direction.x * dt * (this.difficulty === 'Easy' ? 2.6 : this.difficulty === 'Normal' ? 3.3 : this.difficulty === 'Hard' ? 4.2 : 5.1);
        this.position.z += direction.z * dt * (this.difficulty === 'Easy' ? 2.6 : this.difficulty === 'Normal' ? 3.3 : this.difficulty === 'Hard' ? 4.2 : 5.1);
      }

      if (this.cooldown <= 0) {
        this.shoot(player);
        this.cooldown = this.weapon.fireRate;
      }
    } else {
      this.state = 'roam';
      this.angle += dt * (this.difficulty === 'Easy' ? 0.7 : 1.2);
      const drift = new THREE.Vector3(Math.cos(this.angle), 0, Math.sin(this.angle));
      this.position.addScaledVector(drift, dt * 2.3);
      this.mesh.rotation.y = Math.atan2(drift.x, drift.z);
    }

    if (this.position.length() > stormRadius) {
      const dir = this.position.clone().normalize().multiplyScalar(-1);
      this.position.addScaledVector(dir, dt * 8);
    }

    this.mesh.position.copy(this.position);
    this.cooldown -= dt;
    this.mesh.position.y = 0;
  }

  shoot(player) {
    const dist = this.position.distanceTo(player.position);
    if (dist > this.weapon.range) return;

    const shotError = this.aimError * (this.difficulty === 'Easy' ? 2.5 : 1);
    const offset = new THREE.Vector3(
      (Math.random() - 0.5) * shotError,
      (Math.random() - 0.5) * shotError,
      (Math.random() - 0.5) * shotError
    );

    const aim = player.position.clone().add(offset).sub(this.position).normalize();
    const hitChance = this.difficulty === 'Easy' ? 0.58 : this.difficulty === 'Normal' ? 0.72 : this.difficulty === 'Hard' ? 0.85 : 0.95;

    if (Math.random() < hitChance) {
      const damage = this.weapon.damage + (this.difficulty === 'Insane' ? 4 : 0);
      player.takeDamage(damage);
      return damage;
    }
    return 0;
  }
}
